{
  "_comment": "alias -> per-OS launch command. Only what's listed here can ever be run — the agent never executes free-form text, voice or otherwise. process.platform values: darwin (mac), win32 (windows), linux. Windows/Linux commands vary more by install than macOS's 'open -a' — adjust the ones you actually use. Add your own entries following the same shape; no code changes needed.",

  "calculator": { "darwin": "open -a Calculator", "win32": "calc.exe", "linux": "gnome-calculator" },
  "notes": { "darwin": "open -a Notes", "win32": "start ms-notes:", "linux": "gnome-text-editor" },
  "terminal": { "darwin": "open -a Terminal", "win32": "start wt.exe", "linux": "x-terminal-emulator" },
  "iterm": { "darwin": "open -a iTerm", "win32": "start wt.exe", "linux": "x-terminal-emulator" },
  "task manager": { "darwin": "open -a 'Activity Monitor'", "win32": "start taskmgr.exe", "linux": "gnome-system-monitor" },
  "activity monitor": { "darwin": "open -a 'Activity Monitor'", "win32": "start taskmgr.exe", "linux": "gnome-system-monitor" },

  "browser": { "darwin": "open -a 'Google Chrome'", "win32": "start chrome", "linux": "xdg-open https://google.com" },
  "chrome": { "darwin": "open -a 'Google Chrome'", "win32": "start chrome", "linux": "google-chrome" },
  "firefox": { "darwin": "open -a Firefox", "win32": "start firefox", "linux": "firefox" },
  "edge": { "darwin": "open -a 'Microsoft Edge'", "win32": "start msedge", "linux": "microsoft-edge" },
  "brave": { "darwin": "open -a 'Brave Browser'", "win32": "start brave", "linux": "brave-browser" },
  "safari": { "darwin": "open -a Safari" },

  "spotify": { "darwin": "open -a Spotify", "win32": "start spotify:", "linux": "spotify" },
  "music": { "darwin": "open -a Music", "win32": "start spotify:", "linux": "spotify" },
  "vlc": { "darwin": "open -a VLC", "win32": "start vlc", "linux": "vlc" },
  "itunes": { "darwin": "open -a Music", "win32": "start itunes:" },

  "mail": { "darwin": "open -a Mail", "win32": "start outlookmail:", "linux": "xdg-open mailto:" },
  "outlook": { "darwin": "open -a 'Microsoft Outlook'", "win32": "start outlook", "linux": "xdg-open mailto:" },
  "calendar": { "darwin": "open -a Calendar", "win32": "start outlookcal:", "linux": "gnome-calendar" },
  "photos": { "darwin": "open -a Photos", "win32": "start ms-photos:", "linux": "xdg-open ~/Pictures" },
  "camera": { "darwin": "open -a 'Photo Booth'", "win32": "start microsoft.windows.camera:", "linux": "cheese" },
  "preview": { "darwin": "open -a Preview", "win32": "start ms-photos:", "linux": "xdg-open ~/Pictures" },

  "vscode": { "darwin": "open -a 'Visual Studio Code'", "win32": "code", "linux": "code" },
  "code": { "darwin": "open -a 'Visual Studio Code'", "win32": "code", "linux": "code" },
  "docker": { "darwin": "open -a Docker", "win32": "start \"\" \"C:\\Program Files\\Docker\\Docker\\Docker Desktop.exe\"", "linux": "systemctl --user start docker-desktop" },
  "postman": { "darwin": "open -a Postman", "win32": "start postman", "linux": "postman" },
  "xcode": { "darwin": "open -a Xcode" },
  "android studio": { "darwin": "open -a 'Android Studio'", "win32": "start \"\" \"C:\\Program Files\\Android\\Android Studio\\bin\\studio64.exe\"", "linux": "android-studio" },
  "github desktop": { "darwin": "open -a 'GitHub Desktop'", "win32": "start github", "linux": "github-desktop" },

  "finder": { "darwin": "open .", "win32": "explorer.exe", "linux": "xdg-open ." },
  "files": { "darwin": "open .", "win32": "explorer.exe", "linux": "xdg-open ." },
  "settings": { "darwin": "open -a 'System Settings'", "win32": "start ms-settings:", "linux": "gnome-control-center" },
  "dropbox": { "darwin": "open -a Dropbox", "win32": "start \"\" \"%APPDATA%\\..\\Local\\Dropbox\\Client\\Dropbox.exe\"", "linux": "dropbox start" },
  "onedrive": { "darwin": "open -a OneDrive", "win32": "start onedrive", "linux": "xdg-open https://onedrive.live.com" },
  "google drive": { "darwin": "open -a 'Google Drive'", "win32": "start \"\" \"%LOCALAPPDATA%\\Google\\Drive File Stream\\GoogleDriveFS.exe\"", "linux": "xdg-open https://drive.google.com" },

  "slack": { "darwin": "open -a Slack", "win32": "start slack:", "linux": "slack" },
  "discord": { "darwin": "open -a Discord", "win32": "start discord:", "linux": "discord" },
  "whatsapp": { "darwin": "open -a WhatsApp", "win32": "start whatsapp:", "linux": "xdg-open https://web.whatsapp.com" },
  "messages": { "darwin": "open -a Messages", "win32": "start ms-chat:", "linux": "xdg-open https://web.whatsapp.com" },
  "zoom": { "darwin": "open -a zoom.us", "win32": "start zoommtg:", "linux": "zoom" },
  "teams": { "darwin": "open -a 'Microsoft Teams'", "win32": "start msteams:", "linux": "teams" },
  "telegram": { "darwin": "open -a Telegram", "win32": "start tg:", "linux": "telegram-desktop" },
  "signal": { "darwin": "open -a Signal", "win32": "start signal", "linux": "signal-desktop" },

  "word": { "darwin": "open -a 'Microsoft Word'", "win32": "start winword", "linux": "libreoffice --writer" },
  "excel": { "darwin": "open -a 'Microsoft Excel'", "win32": "start excel", "linux": "libreoffice --calc" },
  "powerpoint": { "darwin": "open -a 'Microsoft PowerPoint'", "win32": "start powerpnt", "linux": "libreoffice --impress" },
  "notion": { "darwin": "open -a Notion", "win32": "start notion:", "linux": "notion-app" },
  "obsidian": { "darwin": "open -a Obsidian", "win32": "start obsidian:", "linux": "obsidian" },
  "figma": { "darwin": "open -a Figma", "win32": "start figma", "linux": "figma-linux" },

  "photoshop": { "darwin": "open -a 'Adobe Photoshop 2026'", "win32": "start \"\" \"C:\\Program Files\\Adobe\\Adobe Photoshop 2026\\Photoshop.exe\"" },
  "illustrator": { "darwin": "open -a 'Adobe Illustrator'", "win32": "start \"\" \"C:\\Program Files\\Adobe\\Adobe Illustrator\\Support Files\\Contents\\Windows\\Illustrator.exe\"" },
  "steam": { "darwin": "open -a Steam", "win32": "start steam", "linux": "steam" },

  "lock": { "darwin": "pmset displaysleepnow", "win32": "rundll32.exe user32.dll,LockWorkStation", "linux": "loginctl lock-session" },
  "sleep": { "darwin": "pmset sleepnow", "win32": "rundll32.exe powrprof.dll,SetSuspendState 0,1,0", "linux": "systemctl suspend" },
  "restart": { "darwin": "osascript -e 'tell app \"System Events\" to restart'", "win32": "shutdown /r /t 5", "linux": "systemctl reboot" },
  "shutdown": { "darwin": "osascript -e 'tell app \"System Events\" to shut down'", "win32": "shutdown /s /t 5", "linux": "systemctl poweroff" },
  "sign out": { "darwin": "osascript -e 'tell app \"System Events\" to log out'", "win32": "shutdown /l", "linux": "gnome-session-quit --logout --no-prompt" },

  "mute": { "darwin": "osascript -e 'set volume output muted true'", "win32": "nircmd.exe mutesysvolume 1", "linux": "amixer set Master mute" },
  "unmute": { "darwin": "osascript -e 'set volume output muted false'", "win32": "nircmd.exe mutesysvolume 0", "linux": "amixer set Master unmute" },
  "volume up": { "darwin": "osascript -e 'set volume output volume ((output volume of (get volume settings)) + 10)'", "win32": "nircmd.exe changesysvolume 6553", "linux": "amixer set Master 10%+" },
  "volume down": { "darwin": "osascript -e 'set volume output volume ((output volume of (get volume settings)) - 10)'", "win32": "nircmd.exe changesysvolume -6553", "linux": "amixer set Master 10%-" },
  "brightness up": { "darwin": "osascript -e 'tell application \"System Events\" to key code 144'", "win32": "powershell -Command \"(Get-WmiObject -Namespace root/WMI -Class WmiMonitorBrightnessMethods).WmiSetBrightness(1,100)\"", "linux": "brightnessctl set 10%+" },
  "brightness down": { "darwin": "osascript -e 'tell application \"System Events\" to key code 145'", "win32": "powershell -Command \"(Get-WmiObject -Namespace root/WMI -Class WmiMonitorBrightnessMethods).WmiSetBrightness(1,10)\"", "linux": "brightnessctl set 10%-" },

  "play pause": { "darwin": "osascript -e 'tell application \"Spotify\" to playpause'", "win32": "nircmd.exe sendkeypress 0xB3", "linux": "playerctl play-pause" },
  "next track": { "darwin": "osascript -e 'tell application \"Spotify\" to next track'", "win32": "nircmd.exe sendkeypress 0xB0", "linux": "playerctl next" },
  "previous track": { "darwin": "osascript -e 'tell application \"Spotify\" to previous track'", "win32": "nircmd.exe sendkeypress 0xB1", "linux": "playerctl previous" },

  "screenshot": { "darwin": "screencapture -x ~/Desktop/screenshot-$(date +%s).png", "win32": "powershell -Command \"(New-Object -ComObject WScript.Shell).SendKeys('{PRTSC}')\"", "linux": "gnome-screenshot" },
  "dark mode": { "darwin": "osascript -e 'tell app \"System Events\" to tell appearance preferences to set dark mode to not dark mode'", "win32": "reg add HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize /v AppsUseLightTheme /t REG_DWORD /d 0 /f", "linux": "gsettings set org.gnome.desktop.interface color-scheme prefer-dark" },
  "empty trash": { "darwin": "osascript -e 'tell app \"Finder\" to empty trash'", "win32": "powershell -Command \"Clear-RecycleBin -Force\"", "linux": "gio trash --empty" },
  "dnd on": { "darwin": "shortcuts run 'Set Focus'", "win32": "", "linux": "gsettings set org.gnome.desktop.notifications show-banners false" },
  "dnd off": { "darwin": "shortcuts run 'Turn Off Focus'", "win32": "", "linux": "gsettings set org.gnome.desktop.notifications show-banners true" },
  "wifi on": { "darwin": "networksetup -setairportpower en0 on", "win32": "netsh interface set interface \"Wi-Fi\" enable", "linux": "nmcli radio wifi on" },
  "wifi off": { "darwin": "networksetup -setairportpower en0 off", "win32": "netsh interface set interface \"Wi-Fi\" disable", "linux": "nmcli radio wifi off" },
  "bluetooth on": { "darwin": "blueutil --power 1", "win32": "", "linux": "bluetoothctl power on" },
  "bluetooth off": { "darwin": "blueutil --power 0", "win32": "", "linux": "bluetoothctl power off" }
}
